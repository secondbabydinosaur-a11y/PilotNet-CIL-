__pycache__/
*.py[cod]
.venv/

# PilotNet: 원본 센서 기록과 전체 실행 아카이브는 로컬에 보관한다.
/pilotnet/dataset/raw/
/pilotnet/dataset/unseen_raw/
/pilotnet/dataset/setup/
/pilotnet/dataset/rejected/
/pilotnet/dataset/processed/
/pilotnet/runs/
/pilotnet/github_artifacts/

# PilotNet 공개 결과: 기존 대표 영상 4개와 요약 표를 유지한다.
/pilotnet/results/*
!/pilotnet/results/README.md
!/pilotnet/results/video_sources.json
!/pilotnet/results/curve_sampling.json
!/pilotnet/results/videos/
!/pilotnet/results/images/
!/pilotnet/results/metrics/
/pilotnet/results/videos/*
!/pilotnet/results/videos/*.mp4
/pilotnet/results/images/*
!/pilotnet/results/images/*.jpg
!/pilotnet/results/images/course_map.png
/pilotnet/results/metrics/*
!/pilotnet/results/metrics/*.csv

# CIL: 수집 원본·정답 생성 결과·학습 중간 기록은 별도 보관한다.
/cil/data/raw/
/cil/data/prepared/
/cil/runs/
/cil/checkpoints/

# CIL 공개 결과는 구현 후 선정한 영상·그림·요약 표만 추가한다.
/cil/results/*
!/cil/results/README.md
!/cil/results/videos/
!/cil/results/images/
!/cil/results/metrics/
/cil/results/videos/*
!/cil/results/videos/*.mp4
/cil/results/images/*
!/cil/results/images/*.png
!/cil/results/images/*.jpg
/cil/results/metrics/*
!/cil/results/metrics/*.csv
!/cil/results/metrics/*.json

*.log
.~lock.*#
